  completedStages: new Set(),
  skippedStages: new Set(),
  warningStages: new Set(),
  isRunningAgent: false,
  runToken: 0,
  loopCount: 0,
  dataSourceName: 'Chưa nạp file danh mục',
  filterStatus: 'all',
  searchQuery: '',
  api: {
    configured: false,
    maskedKey: '',
    model: 'gemini-2.5-flash',
    useLiveApi: true,
    lastEndpoint: ''
  },
  analytics: {
    importedRecords: [],
    groupField: 'owner',
    customFields: [],
    sourceLabels: [],
    lastSchemaSummary: '',
    aiReport: null,
    previewLimit: 100,
    currentDataset: null,
    currentColMap: {},
    columnMapPanelOpen: false
  },
  dealsPreviewLimit: 100,

  opp: createEmptyOpportunity()
};

